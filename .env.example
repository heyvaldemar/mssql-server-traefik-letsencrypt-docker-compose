# Microsoft SQL Server + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest lives in
# the compose file's `x-images` block, so `git pull` delivers the versions
# this repository has tested. To pin differently, uncomment:
# MSSQL_IMAGE_TAG=mcr.microsoft.com/mssql/server:2022-CU26-ubuntu-22.04@sha256:…
# TRAEFIK_IMAGE_TAG=traefik:3.7@sha256:…

# Traefik Variables
# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# The email address used by Let's Encrypt for renewal notices.
# REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# The hostname of the Traefik dashboard (DNS must point at this server).
# REQUIRED.
TRAEFIK_HOSTNAME=traefik.mssql.example.com

# Basic auth for the Traefik dashboard.
# REQUIRED. Generate your own (replace the username and password):
#     htpasswd -nB traefikadmin
# or with Docker, no local htpasswd needed:
#     docker run --rm httpd:2.4 htpasswd -nbB traefikadmin your-password
# Escape every `$` in the hash as `$$` when pasting into this file.
TRAEFIK_BASIC_AUTH=

# Microsoft SQL Server Variables
# The `sa` (system administrator) password.
# REQUIRED. SQL Server enforces complexity: at least 8 characters with
# uppercase, lowercase, digits and symbols. Generate with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 24; echo '-aA1!'
MSSQL_SA_PASSWORD=

# Edition to run: Developer, Express, Standard, Enterprise, or a product
# key. Developer is full-featured but licensed for non-production use
# only. Default: Developer.
# MSSQL_PID=Developer

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# MSSQL_SERVER_MSSQL_MEMORY_LIMIT=2g
# MSSQL_SERVER_MSSQL_CPU_LIMIT=2.0
# MSSQL_SERVER_MSSQL_MEMORY_RESERVATION=256m
# MSSQL_SERVER_MSSQL_CPU_RESERVATION=0.5
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1

# Backup Variables (defaults shown). The backups service runs BACKUP DATABASE
# for master, msdb and every user database on a loop, verifies each file with
# RESTORE VERIFYONLY, and prunes old files. Files land in the
# mssql-server-backups volume, shared with the server.
# MSSQL_BACKUP_INIT_SLEEP=30m
# MSSQL_BACKUP_INTERVAL=24h
# MSSQL_BACKUP_PRUNE_DAYS=7
# MSSQL_BACKUPS_PATH=/var/opt/mssql/backup
# MSSQL_BACKUP_NAME=mssql-backup
